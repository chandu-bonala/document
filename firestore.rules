rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create: if isOwner(adminId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'admin';
      allow update: if isAdmin() || isOwner(adminId);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.courseId is string
        && request.resource.data.courseTitle is string
        && request.resource.data.paymentId is string
        && request.resource.data.status is string
        && request.resource.data.amount is number;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == resource.data.userUid
      );
      allow delete: if isAdmin();
    }
  }
}
